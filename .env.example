# Datenbank (PostgreSQL – z.B. Supabase/Vercel Postgres/Railway).
# Zwei Verbindungen nötig (nur bei Supabase – bei den meisten anderen
# Anbietern reicht eine, dann DIRECT_URL = DATABASE_URL):
#
# DATABASE_URL – der Connection-POOLER (Project Settings → Database →
#   Connection string → "Transaction" Modus, Port 6543). Wird zur Laufzeit
#   von der App verwendet.
# DIRECT_URL   – die DIREKTE Verbindung (gleiche Seite → "Session" Modus
#   bzw. "Direct connection", Port 5432). Wird NUR beim Deployment für
#   "prisma migrate deploy" gebraucht – der Pooler unterstützt die dafür
#   nötigen Advisory Locks nicht und der Build bleibt sonst wortlos hängen.
#
# Bei beiden: Passwort einsetzen, eckige Klammern entfernen, Sonderzeichen
# im Passwort URL-kodieren (z.B. @ -> %40).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DBNAME?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# NextAuth (Admin-Login UND Grundlage für die Self-Service-Konten/Sessions,
# siehe src/lib/session.ts)
# Erzeuge einen zufälligen Wert, z.B. mit: openssl rand -base64 32
NEXTAUTH_SECRET="bitte-zufaelligen-wert-einsetzen"
NEXTAUTH_URL="http://localhost:3000"

# Erst-Admin-Zugang (wird beim Seed-Skript ODER beim Aufruf von /api/setup angelegt)
SEED_ADMIN_EMAIL="info@ralph-kuester.de"
SEED_ADMIN_PASSWORD="bitte-sicheres-passwort-setzen"

# Aktiviert den einmaligen Setup-Endpunkt /api/setup?secret=<dieser-Wert> –
# legt den Admin-Zugang per Browser-Aufruf an, ganz ohne Terminal (praktisch
# bei einem reinen Web-Deployment). Erzeugen z.B. mit: openssl rand -base64 32
SETUP_SECRET=""

# SAP-Integration (optional – nur nötig, wenn Sie einer Firma im Admin-Bereich
# SAP-Zugangsdaten hinterlegen). Verschlüsselt damit alle SAP Client Secrets
# in der Datenbank. Erzeugen z.B. mit: openssl rand -base64 32
SAP_CREDENTIALS_KEY=""

# Secret für den geplanten SAP-Export-Aufruf (/api/cron/sap-export), z.B. von
# Vercel Cron oder einer GitHub Action als "Authorization: Bearer <Wert>"
# mitgeschickt. Erzeugen z.B. mit: openssl rand -base64 32
CRON_SECRET=""

# E-Mail-Versand (optional – Resend, https://resend.com, kostenloser Tier
# reicht zum Start). Ohne diese beiden Werte funktioniert alles wie gehabt:
# Einladungslinks/Digistore24-Zugangslinks werden weiterhin angelegt, müssen
# dann aber manuell kopiert/verschickt werden.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Digistore24-Verkauf (siehe DIGISTORE24_SETUP.md für die Einrichtung in
# Digistore24 selbst – Produkt-IDs, IPN-URL, Passphrase).
#
# DIGISTORE24_IPN_PASSPHRASE – die in Digistore24 unter "IPN-Konfiguration"
#   hinterlegte Passphrase, MUSS exakt übereinstimmen (siehe src/lib/digistore24.ts).
DIGISTORE24_IPN_PASSPHRASE=""
# NEXT_PUBLIC_APP_URL – die öffentliche URL der App (ohne Slash am Ende),
# wird für den Aktivierungslink in der Kauf-Bestätigungsmail verwendet.
NEXT_PUBLIC_APP_URL="https://qet-kultur-kompass.vercel.app"
