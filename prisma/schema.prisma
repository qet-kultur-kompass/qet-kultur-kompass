// QET Unternehmenskultur-Dashboard – Datenmodell
// Produktiv-Provider: PostgreSQL (z.B. Supabase/Vercel Postgres/Railway).
// Für rein lokale Entwicklung ohne eigenen Postgres kann testweise wieder auf
// "sqlite" umgestellt werden – dann aber prisma/migrations/ neu erzeugen
// (npx prisma migrate dev), da die vorhandene Migration für Postgres geschrieben ist.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Für "prisma migrate deploy" beim Vercel-Build: Migrationen brauchen eine
  // direkte Verbindung (Session-/Direct-Modus, meist Port 5432). Der normale
  // DATABASE_URL zeigt bei Supabase auf den "Transaction"-Pooler (Port 6543),
  // der für Migrationen hängen bleibt, da er die dafür nötigen Sperren nicht
  // unterstützt. Siehe README, Abschnitt "Datenbank".
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}

// Eine "Firma" = ein Kunde der QET-Masterclass, der das Kultur-Dashboard nutzt.
// Kann entweder ein Einzelkunde sein (accountType "individual", nimmt selbst
// an der Befragung teil) oder eine Firma mit mehreren eingeladenen Personen
// (accountType "company").
// surveyToken -> öffentlicher Einladungslink für Mitarbeiter/Kunden/Partner (kein Login nötig)
// dashboardToken -> read-only Link, mit dem die Firma selbst ihr Ergebnis einsehen kann (ohne Login teilbar)
model Company {
  id             String       @id @default(cuid())
  name           String
  contactName    String?
  contactEmail   String?
  surveyToken    String       @unique
  dashboardToken String       @unique
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  submissions    Submission[]

  // --- Self-Service-Konto ---------------------------------------------
  accountType       String  @default("company")
  ownerName         String?
  ownerEmail        String? @unique
  ownerPasswordHash String?

  // --- Abrechnung / Bezahlschranke -------------------------------------
  billingProvider String @default("free")
  billingSource      String?
  digistore24OrderId String? @unique
  tier            String?
  planLabel       String?
  participantLimit Int    @default(3)

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  renewalReminderSentAt DateTime?
  accountSetupToken String?   @unique
  accountSetupTokenExpiresAt DateTime?

  // --- SAP-Integration ---------------------------------------------------
  sapEnabled          Boolean   @default(false)
  sapSystemType        String?
  sapTenantUrl         String?
  sapAuthMode          String?
  sapClientId          String?
  sapClientSecretEnc   String?
  sapCompanyId         String?

  sapExportWebhookUrl    String?
  sapExportWebhookSecretEnc String?
  sapExportEnabled       Boolean @default(false)

  sapSsoEnabled     Boolean @default(false)
  sapSsoIssuerUrl   String?
  sapSsoClientId    String?
  sapSsoClientSecretEnc String?

  sapLastSyncAt   DateTime?
  sapLastExportAt DateTime?

  invitees Invitee[]
}

model Invitee {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId    String?
  name          String?
  email         String?
  department    String?
  role          String    @default("employee")
  inviteToken   String    @unique
  status        String    @default("pending")
  source        String    @default("manual")
  completedAt   DateTime?
  lastRemindedAt DateTime?
  createdAt     DateTime  @default(now())

  passwordHash String?
  isOwner      Boolean  @default(false)

  submissions Submission[]

  strategyIntro String @default("")
  criterionNotes CriterionNote[]
  goals          Goal[]

  @@index([companyId])
  @@unique([companyId, externalId])
}

model Submission {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviteeId          String?
  invitee            Invitee? @relation(fields: [inviteeId], references: [id], onDelete: SetNull)
  role               String
  label              String?
  language           String
  testScope          String   @default("full")
  respondentName     String?
  respondentEmail    String?
  qualityScore       Float
  ethicsScore        Float
  transparencyScore  Float
  qetIndex           Float
  scopeIndex         Float    @default(0)
  answers            String
  createdAt          DateTime @default(now())

  @@index([companyId])
  @@index([inviteeId])
}

model CriterionNote {
  id          String   @id @default(cuid())
  inviteeId   String
  invitee     Invitee  @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  criterionId String
  text        String   @default("")
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([inviteeId])
  @@unique([inviteeId, criterionId])
}

model Goal {
  id          String    @id @default(cuid())
  inviteeId   String
  invitee     Invitee   @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  pillar      String?
  dueDate     DateTime?
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([inviteeId])
  @@index([inviteeId, dueDate])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  externalId  String?
  payloadJson String
  status      String   @default("received")
  receivedAt  DateTime @default(now())

  @@index([provider, eventType])
  @@index([externalId])
}
